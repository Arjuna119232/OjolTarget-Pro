<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF071A12"
                android:centerColor="#FF090D16"
                android:endColor="#FF070B12"
                android:type="linear" />
